# Copy this file to .env.production on the deployment host. Replace every
# placeholder, use unique random values, and never commit the resulting file.
GROQ_API_KEY=replace-with-provider-key
CHAT_API_KEYS={"web":"replace-with-at-least-32-byte-random-secret"}
CHAT_RATE_LIMIT_REQUESTS=20
CHAT_RATE_LIMIT_WINDOW_SECONDS=60

# Independent long random secrets; use URL-safe alphanumeric values.
REDIS_PASSWORD=replace-with-a-long-random-secret
QDRANT_API_KEY=replace-with-another-long-random-secret

# Required by the app-level login in addition to the Nginx admin password file.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-unique-password

# Optional telemetry; leave empty to disable export.
LOGFIRE_TOKEN=
