# Copy to .env.production on the deployment host and replace every placeholder.
GROQ_API_KEY=replace-with-your-groq-api-key
FALLBACK_GROQ_API_KEY=
SESSION_HMAC_SECRET=replace-with-at-least-32-random-bytes
VOYAGE_API_KEY=replace-with-your-voyage-api-key

# Deployment-specific endpoint; general runtime defaults are in config/defaults.yaml.
QDRANT_URL=https://your-qdrant-cluster.example
QDRANT_API_KEY=replace-with-your-qdrant-api-key
REDIS_PASSWORD=replace-with-a-strong-random-password

ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-random-password
LOGFIRE_TOKEN=
