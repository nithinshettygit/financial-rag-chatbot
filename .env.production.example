# Local production values. Replace every placeholder before deployment.
# Never commit real credentials; inject secrets through the deployment environment.
GROQ_API_KEY=replace-with-a-valid-groq-api-key
FALLBACK_GROQ_API_KEY=
SESSION_HMAC_SECRET=replace-with-at-least-32-random-bytes
SESSION_TTL_SECONDS=86400
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax

REDIS_PASSWORD=replace-with-a-long-random-secret
QDRANT_URL=https://replace-with-your-qdrant-host
QDRANT_API_KEY=replace-with-a-long-random-secret
COLLECTION_NAME=financial_rag_analytics

CHAT_SESSION_RATE_LIMIT_REQUESTS=20
CHAT_IP_RATE_LIMIT_REQUESTS=60
CHAT_RATE_LIMIT_WINDOW_SECONDS=60
MAX_CONCURRENT_RAG=1
MAX_QUEUE_WAITERS=10
RAG_QUEUE_MAX_WAIT_SECONDS=15
RAG_QUEUE_POLL_INTERVAL_SECONDS=0.25
RAG_QUEUE_RETRY_AFTER_SECONDS=2
RAG_CONCURRENCY_LEASE_SECONDS=60
REQUEST_TIMEOUT_S=80
GUARDRAILS_ENABLED=true
GUARDRAILS_FAIL_OPEN=false

ADMIN_USERNAME=replace-with-an-admin-username
ADMIN_PASSWORD=replace-with-a-long-random-password
LOGFIRE_TOKEN=
TOKENIZERS_PARALLELISM=false
OMP_NUM_THREADS=2
HF_HUB_DISABLE_TELEMETRY=1